# Copy to .env and adjust as needed. The defaults work out of the box.
WEB_PORT=4000
MCP_PORT=4004
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=doit_dev
# Host other machines use to reach this box (LAN IP or domain); composed URLs use it.
PUBLIC_HOST=localhost
# Full override for the agent endpoint URL when scheme/port differ (e.g. hosted TLS); normally leave unset.
MCP_PUBLIC_URL=
