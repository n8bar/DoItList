# Copy to .env and adjust as needed. The defaults work out of the box.
# WEB_PORT is the published host port, and the default port composed into
# public URLs — if an override file remaps the app's public port, set this to
# match.
WEB_PORT=4000
MCP_PORT=4004
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=doit_dev
# The address other machines use to reach this box; composed URLs (API links,
# agent connect pastes) are built from it. Agent clients refuse plain http off
# loopback, so an instance others reach over https has to say so here.
#   PUBLIC_HOST   — LAN IP or domain.
#   PUBLIC_SCHEME — http (default) or https.
#   PUBLIC_PORT   — defaults to WEB_PORT; set it when the public port isn't the
#                   published one.
# Worked example: an https reverse proxy on 443 forwarding to this container's
# published 4000, plus the agent endpoint's own proxied address —
#   PUBLIC_SCHEME=https
#   PUBLIC_HOST=doitlist.example.com
#   PUBLIC_PORT=443
#   MCP_PUBLIC_URL=https://doitlist.example.com:4004
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http
PUBLIC_PORT=
# Full override for the agent endpoint URL when scheme/port differ (e.g. hosted TLS); normally leave unset.
MCP_PUBLIC_URL=
